{
  "name": "si2pem-reader",
  "version": "0.3.2",
  "description": "Reader for SI2PEM WFS, WMS, public REST data, and laboratory PDF reports",
  "keywords": [
    "antenna",
    "geojson",
    "pdf",
    "poland",
    "radio",
    "si2pem",
    "wfs",
    "wms"
  ],
  "homepage": "https://github.com/btsearch/si2pem-reader#readme",
  "bugs": {
    "url": "https://github.com/btsearch/si2pem-reader/issues"
  },
  "license": "MIT",
  "author": "ririxi <dev@ririxi.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btsearch/si2pem-reader.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reports": {
      "types": "./dist/reports/index.d.ts",
      "import": "./dist/reports/index.js",
      "default": "./dist/reports/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "node --test --test-isolation=none --experimental-strip-types test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}
